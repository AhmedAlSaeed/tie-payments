{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "lsp": {
    "surrealql-lsp": {
      "command": [
        "surrealql-language-server"
      ],
      "extensions": [
        ".surql"
      ],
      "initialization": {
        "surrealql": {
          "activeAuthContext": "root",
          "metadata": {
            "mode": "workspace"
          }
        }
      }
    }
  },
  "mcp": {
    "surrealdb": {
      "type": "remote",
      "url": "http://127.0.0.1:8000/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Basic {env:SURREALDB_BASIC_AUTH}"
      }
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "enabled": true
    },
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    }
  }
}