{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "surrealdb": {
      "type": "local",
      "command": ["surreal", "mcp", "--ns", "tie_payments", "--db", "main", "memory"],
      "enabled": true,
      "environment": {
        "SURREAL_USER": "root",
        "SURREAL_PASS": "root"
      }
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "enabled": true
    }
  }
}
