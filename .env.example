# SurrealDB root credentials for docker-compose
SURREALDB_USER=root
SURREALDB_PASS=root

# Base64 of "USER:PASS" for the SurrealDB HTTP /mcp server used by the opencode MCP.
# Generate with:  printf '%s:%s' "$SURREALDB_USER" "$SURREALDB_PASS" | base64
SURREALDB_BASIC_AUTH=cm9vdDpyb290

# App -> SurrealDB connection (defaults match docker-compose.yml)
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_NAMESPACE=tie
SURREALDB_DATABASE=payments

# SurrealKit connection (https://github.com/surrealdb/surrealkit) — used by
# `surrealkit sync/rollout/seed/typegen`. Different var names than the app SDK.
SURREALDB_HOST=http://localhost:8000
SURREALDB_NAME=payments
SURREALDB_PASSWORD=root

# Better Auth
BETTER_AUTH_SECRET=kYsQPfWtvpIXI7FCdjzSoIwKR55JEZ9IQlHuIyRH7cY=
BETTER_AUTH_URL=http://localhost:3000