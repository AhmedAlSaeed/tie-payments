# SurrealDB root credentials for docker-compose
SURREALDB_USER=root
SURREALDB_PASS=root

# Base64 of "USER:PASS" for the SurrealDB HTTP /mcp server used by the opencode MCP.
# Generate with:  printf '%s:%s' "$SURREALDB_USER" "$SURREALDB_PASS" | base64
SURREALDB_BASIC_AUTH=cm9vdDpyb290

# App -> SurrealDB connection (defaults match docker-compose.yml)
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_NAMESPACE=tie
SURREALDB_DATABASE=payments

